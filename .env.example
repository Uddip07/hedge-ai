# ==============================================================================
# MONEYYYYYY - Indian AI Hedge Fund Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Backend / API
APP_APP_NAME=Indian AI Hedge Fund Platform
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db.<project>.supabase.co:5432/postgres
APP_REDIS_URL=redis://default:password@redis.upstash.io:6379
APP_CACHE_ENABLED=true
APP_CACHE_DEFAULT_TTL=300
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json
APP_MAX_POSITION_SIZE_PCT=10.0
APP_MAX_SECTOR_CONCENTRATION_PCT=25.0
APP_API_TITLE=MONEYYYYYY API
APP_API_VERSION=0.1.0
APP_API_DESCRIPTION=Institutional-Grade Multi-Agent AI Investment Research & Execution Platform for Indian Markets
APP_API_DOCS_URL=/docs
APP_API_REDOC_URL=/redoc
APP_API_OPENAPI_URL=/openapi.json
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://www.your-vercel-app.vercel.app
JWT_SECRET_KEY=replace-with-strong-random-secret

# Frontend
VITE_API_BASE_URL=https://your-backend-url.railway.app

# External providers
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=https://your-backend-url.railway.app/auth/zerodha/callback
ZERODHA_TOKEN_STORE_PATH=/tmp/zerodha_session.json
GEMINI_API_KEY=

# Historical Market Data Platform Configuration
MARKET_DATA_PATH=D:\MarketData
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=moneyyyyyy_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==============================================================================
# n8n Native Automation & Orchestration Configuration (Windows)
# ==============================================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-secure-32-char-encryption-key
N8N_WEBHOOK_SECRET=replace-with-secure-webhook-secret
N8N_DIAGNOSTICS_ENABLED=false
N8N_DEFAULT_TIMEZONE=Asia/Kolkata
FASTAPI_BASE_URL=http://localhost:8000
APP_API_AUTOMATION_KEY=replace-with-internal-automation-api-key

