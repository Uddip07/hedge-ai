{
  "name": "MONEYYYYYY — News Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 9-15 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-news-trigger",
      "name": "Trading Hours News Schedule (30m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.FASTAPI_BASE_URL || 'http://localhost:8000') + '/market/news/ingest' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.APP_API_AUTOMATION_KEY || 'dev-automation-secret-key' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "[\"RELIANCE\", \"TCS\", \"INFY\", \"HDFCBANK\", \"ICICIBANK\", \"SBIN\", \"BHARTIARTL\", \"ITC\", \"LT\"]",
        "options": {
          "timeout": 30000,
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 4000
        }
      },
      "id": "http-ingest-news",
      "name": "Trigger FastAPI News Ingestion & Deduplication",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-news-metrics",
              "name": "news_pipeline_result",
              "value": "=Successfully ingested and deduplicated {{ $json.articles_count }} articles across {{ $json.tickers_queried.length }} tracked tickers.",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-news-summary",
      "name": "Format News Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Trading Hours News Schedule (30m)": {
      "main": [
        [
          {
            "node": "Trigger FastAPI News Ingestion & Deduplication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger FastAPI News Ingestion & Deduplication": {
      "main": [
        [
          {
            "node": "Format News Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "MONEYYYYYY",
      "id": "moneyyyyyy-tag"
    }
  ]
}
