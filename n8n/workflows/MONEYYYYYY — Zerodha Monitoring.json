{
  "name": "MONEYYYYYY — Zerodha Monitoring",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 9-15 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-broker-monitor",
      "name": "Market Hours Broker Schedule (5m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.FASTAPI_BASE_URL || 'http://localhost:8000') + '/broker/health' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.APP_API_AUTOMATION_KEY || 'dev-automation-secret-key' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 3000
        }
      },
      "id": "http-check-broker-health",
      "name": "Query FastAPI Broker Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-broker-auth",
              "leftValue": "={{ $json.is_authenticated }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-broker-auth-ok",
      "name": "Check Broker Authentication",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-rejections",
              "leftValue": "={{ $json.orders_summary?.rejected_orders || 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-has-order-rejections",
      "name": "Check for Rejected Orders",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.FASTAPI_BASE_URL || 'http://localhost:8000') + '/api/v1/alerts/dispatch' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.APP_API_AUTOMATION_KEY || 'dev-automation-secret-key' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"alert_type\": \"ORDER_REJECTION\",\n  \"severity\": \"WARNING\",\n  \"source\": \"n8n_zerodha_monitoring\",\n  \"title\": \"Broker Order Rejections Detected\",\n  \"message\": \"Found \" + $json.orders_summary.rejected_orders + \" rejected orders. Rejection details: \" + JSON.stringify($json.orders_summary.recent_rejections),\n  \"metadata\": $json\n}",
        "options": {}
      },
      "id": "http-dispatch-rejection-alert",
      "name": "Dispatch Order Rejection Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 160]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-broker-status-ok",
              "name": "monitor_status",
              "value": "=Broker connection active. Total orders: {{ $json.orders_summary.total_orders }}, Open: {{ $json.orders_summary.open_orders }}, Rejections: 0",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-broker-normal",
      "name": "Log Normal Broker State",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1160, 280]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.FASTAPI_BASE_URL || 'http://localhost:8000') + '/api/v1/alerts/dispatch' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.APP_API_AUTOMATION_KEY || 'dev-automation-secret-key' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"alert_type\": \"BROKER_FAILURE\",\n  \"severity\": \"CRITICAL\",\n  \"source\": \"n8n_zerodha_monitoring\",\n  \"title\": \"Zerodha Broker Connection / Session Invalid\",\n  \"message\": \"Broker session is not authenticated or connection failed: \" + ($json.error || 'Unknown auth error'),\n  \"metadata\": $json\n}",
        "options": {}
      },
      "id": "http-dispatch-broker-failure",
      "name": "Dispatch Broker Failure Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 420]
    }
  ],
  "connections": {
    "Market Hours Broker Schedule (5m)": {
      "main": [
        [
          {
            "node": "Query FastAPI Broker Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query FastAPI Broker Health": {
      "main": [
        [
          {
            "node": "Check Broker Authentication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Broker Authentication": {
      "main": [
        [
          {
            "node": "Check for Rejected Orders",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Dispatch Broker Failure Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check for Rejected Orders": {
      "main": [
        [
          {
            "node": "Dispatch Order Rejection Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Normal Broker State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "MONEYYYYYY",
      "id": "moneyyyyyy-tag"
    }
  ]
}
