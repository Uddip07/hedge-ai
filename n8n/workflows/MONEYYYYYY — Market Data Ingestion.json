{
  "name": "MONEYYYYYY — Market Data Ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 16 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-trigger-1",
      "name": "Market Close Schedule (16:00 IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.FASTAPI_BASE_URL || 'http://localhost:8000') + '/api/v1/market-data/sync' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.APP_API_AUTOMATION_KEY || 'dev-automation-secret-key' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"symbols\": [\"RELIANCE\", \"TCS\", \"INFY\", \"HDFCBANK\", \"ICICIBANK\", \"SBIN\", \"BHARTIARTL\", \"ITC\", \"KOTAKBANK\", \"LT\"],\n  \"days\": 30\n}",
        "options": {
          "timeout": 60000,
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000
        }
      },
      "id": "http-sync-market-data",
      "name": "Trigger FastAPI Yahoo Market Data Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-success",
              "leftValue": "={{ $json.status }}",
              "rightValue": "COMPLETED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-sync-success",
      "name": "Check Ingestion Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-success",
              "name": "result",
              "value": "=Market Data Ingestion Successful: {{ $json.symbols_synced }} symbols synced, {{ $json.rows_imported }} price records imported.",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-success-log",
      "name": "Format Ingestion Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.FASTAPI_BASE_URL || 'http://localhost:8000') + '/api/v1/alerts/dispatch' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.APP_API_AUTOMATION_KEY || 'dev-automation-secret-key' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"alert_type\": \"IMPORT_FAILURE\",\n  \"severity\": \"ERROR\",\n  \"source\": \"n8n_market_data_ingestion\",\n  \"title\": \"Market Data Sync Failed\",\n  \"message\": \"Ingestion status: \" + ($json.status || 'UNKNOWN') + \". Errors: \" + JSON.stringify($json.errors || []),\n  \"metadata\": $json\n}",
        "options": {}
      },
      "id": "http-dispatch-alert",
      "name": "Dispatch Import Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 400]
    }
  ],
  "connections": {
    "Market Close Schedule (16:00 IST)": {
      "main": [
        [
          {
            "node": "Trigger FastAPI Yahoo Market Data Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger FastAPI Yahoo Market Data Sync": {
      "main": [
        [
          {
            "node": "Check Ingestion Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Ingestion Status": {
      "main": [
        [
          {
            "node": "Format Ingestion Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Dispatch Import Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "MONEYYYYYY",
      "id": "moneyyyyyy-tag"
    }
  ]
}
